# Copy to CIRCUITPY/settings.toml and fill in your local values.
# Keep the real settings.toml off Git and do not paste passwords into logs.
WIFI_SSID = ""
WIFI_PASSWORD = ""

# Optional separate open test AP. Leave empty to skip the open-network gate.
OPEN_WIFI_SSID = ""

# DNS target; ping the DHCP gateway so public ICMP filtering is irrelevant.
DNS_TEST_HOST = "example.com"

# Phase 4 TCP/UDP acceptance targets and capacity stress count.
HTTP_TEST_HOST = "example.com"
NTP_TEST_HOST = "pool.ntp.org"
SOCKET_CYCLES = 100

# Phase 5 verified HTTPS target and TLS reuse count.
TLS_TEST_HOST = "sha256.badssl.com"
TLS_CYCLES = 100
